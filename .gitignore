dist
coverage
playwright-report
test-results
.validation
.collection
bin/yt-dlp
.env
.env.local
.env.*.local
supabase/.branches
supabase/.temp
*.tsbuildinfo
# Auto-generated by `npx expo install --fix` at the workspace root.
# The mobile app uses apps/mobile/tsconfig.json; this top-level file is harmless
# but recreates itself on every install, so we keep it untracked.
/tsconfig.json
.env.hosted
# Dated copies of it (.env.hosted.bak-20260921005025 turned up untracked, NOT
# ignored): same service-role key and database password, and this repo is public.
.env*.bak*
.vercel

# macOS Finder view state. Recreated in any directory Finder opens; nothing to do
# with the project.
.DS_Store

# Claude Code: per-machine settings and their dated backups stay local, but
# .claude/launch.json is shared dev-server config and IS committed.
.claude/settings.local.json
.claude/*.bak-*

# Store listing: raw device captures are large and reproducible from the
# runbooks; the composed upload artifacts next to them ARE committed.
store-assets/ios/
store-assets/android/

# Android signing material. `eas credentials` can download the release keystore
# and its passwords to disk (credentials.json + a .jks); committing either would
# publish the private key that signs the app AND the key registered for Android
# developer verification. Neither is recoverable once leaked.
credentials.json
**/credentials.json
*.jks
*.keystore

# Apple credentials. An App Store Connect API key (.p8) can upload builds and
# change app metadata; this repo is public, so these must never be committed.
# Keep them in ~/.appstoreconnect/private_keys/ instead.
*.p8
AuthKey_*.p8

# Store credentials referenced by eas.json submit profiles by path. The paths
# are committed so submissions run unattended; the keys never are. Whole
# directory, not a pattern per file type — a Play service account is .json,
# which is far too common an extension to blocklist safely.
apps/mobile/credentials/
