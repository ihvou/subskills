# Website: copy these to apps/web/.env.local.
# Leave the two Supabase values empty to run on the built-in demo catalog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Website, server side only: admin pages and on-demand page refreshes.
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATE_SECRET=
INTERNAL_FUNCTION_TOKEN=

# How many published videos a sub-skill needs before its page is public (default 3).
PUBLISH_MIN_RESOURCES=

# Set to 1 to open the admin pages locally without signing in. Never in production.
DEMO_MODE=

# iOS app: copy these to apps/mobile/.env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WEB_BASE_URL=https://subskills.xyz
